# ---------------------------------------------------------------------------
# Copy to .env and fill in the sources you want. Anything left blank is simply
# skipped — the dashboard renders a hint in that card instead of failing.
# ---------------------------------------------------------------------------

PORT=4300
CACHE_TTL_SECONDS=90

# --- Linear ----------------------------------------------------------------
# Linear → Settings → Security & access → Personal API keys → New key
LINEAR_API_KEY=

# --- GitLab ----------------------------------------------------------------
# Your instance root, e.g. https://gitlab.com or https://gitlab.your-company.com
GITLAB_HOST=https://gitlab.com
# Profile → Access tokens → scope: read_api
GITLAB_TOKEN=

# --- Slack -----------------------------------------------------------------
# Must be a USER token (starts with xoxp-), not a bot token: only user tokens
# can search your messages. api.slack.com/apps → your app →
# OAuth & Permissions → User Token Scopes: search:read, im:read, im:history,
# mpim:read, mpim:history, users:read → Install to workspace.
SLACK_USER_TOKEN=
SLACK_MENTION_LIMIT=20
SLACK_DM_SCAN_LIMIT=25

# --- Google Calendar -------------------------------------------------------
# Google Calendar → Settings → <your calendar> → "Secret address in iCal format".
# Treat this URL as a password; anyone holding it can read your calendar.
GOOGLE_CALENDAR_ICS_URL=
# Optional: your calendar address, so invitations you declined are hidden.
GOOGLE_CALENDAR_EMAIL=
